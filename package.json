{
  "name": "far-visualizer",
  "private": true,
  "type": "module",
  "homepage": "https://awilmoth895.github.io/FAR-Visualizer/",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
